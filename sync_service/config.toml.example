# Aldelo → Convex sync service config (Python)
# Copy to config.toml and set paths for your POS machine.
# Optional: set CONVEX_URL and CONVEX_API_KEY in the environment (e.g. NSSM "App environment").

# Option A: Path only (we build the connection string)
mdb_path = "C:\\Aldelo\\Data\\ChathamSandwich.mdb"

# Option B: Full connection string (use if Option A fails with "Data source not found" - e.g. bitness mismatch).
# Copy from your working config.ini [database] connection_string:
# connection_string = "DRIVER={Microsoft Access Driver (*.mdb)};DBQ=C:\\Chatham\\ChathamSandwich.mdb;READONLY=TRUE;"
convex_url = "https://your-deployment.convex.site/api/ingest_orders"
cursor_path = "C:\\AldeloSync\\cursor.json"

# Poll every 5 seconds when healthy
poll_interval_secs = 5

# On MDB lock/error: quick retries then exponential backoff
backoff_initial_secs = 10
backoff_multiplier = 2
backoff_max_secs = 60
quick_retries = 2

# Rows per batch (OrderHeaders; related transactions/payments/refunds fetched for same orders)
batch_size = 200
