# Aldelo → Convex sync service config
# Copy to config.ini and set paths for your POS machine.
# Optional: set CONVEX_URL and CONVEX_API_KEY in the environment (e.g. NSSM "App environment").
#
# You can share [database] with testapp/aldelo.py - both use the same connection_string.
# If testapp already works, add the [sync] section below to your existing config.ini.

[database]
# Option A: Full connection string (same as testapp config.ini)
connection_string = DRIVER={Microsoft Access Driver (*.mdb)};DBQ=C:\Chatham\ChathamSandwich.mdb;READONLY=TRUE;

# Option B: Path only (comment connection_string above, uncomment mdb_path in [sync])
[sync]
# mdb_path = C:\Chatham\ChathamSandwich.mdb
convex_url = https://bold-camel-432.convex.cloud/api/ingest_orders
cursor_path = C:\convexsync\cursor.json

# Poll every 5 seconds when healthy
poll_interval_secs = 5

# On MDB lock/error: quick retries then exponential backoff
backoff_initial_secs = 10
backoff_multiplier = 2
backoff_max_secs = 60
quick_retries = 2

# Rows per batch
batch_size = 200
